APP_ENV=development
# Only the actual proxy hops, never 0.0.0.0/0 or ::/0.
TRUSTED_PROXY_CIDRS=
API_ADDR=127.0.0.1:18080
# Use the dedicated backend login; never expose this URL to the browser.
DATABASE_URL=postgres://firstorder_backend:CHANGE_ME@127.0.0.1:15432/postgres?sslmode=disable
SUPABASE_URL=https://e2.iq-home.kz
SUPABASE_ANON_KEY=
# Optional legacy HS256 verifier. If empty, tokens are verified by Supabase /user.
JWT_SECRET=
JWT_ISSUER=https://e2.iq-home.kz/auth/v1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_REDIRECT_URL=http://localhost:3000/auth/callback
# Set false only for local HTTP development. Production uses true + HTTPS.
COOKIE_SECURE=true
# Optional internal importer and monitoring bearer credentials, at least 32 chars.
IMPORTER_TOKEN=
READY_TOKEN=
IMPORT_CSV_PATH=testdata/companies.csv
# Operator-run collector only. Public endpoint is for bounded manual pilots.
OVERPASS_URL=https://overpass-api.de/api/interpreter
RATE_LIMIT_PER_MINUTE=120
